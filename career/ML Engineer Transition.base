filters:
  or:
    - type == "project"
    - type == "skill-map"
    - type == "ml-note"
formulas:
  status_label: if(status == "completed", "✅ 완료", if(status == "in-progress", "🚧 진행", if(status == "active", "📝 정리", "📌 예정")))
  evidence_gap: if(type == "project" && (!evidence.contains("code") || !evidence.contains("benchmark")), "보완 필요", "")
properties:
  file.name:
    displayName: 항목
  formula.status_label:
    displayName: 상태
  formula.evidence_gap:
    displayName: 증거
  focus:
    displayName: 역량
  position:
    displayName: 포지션
  evidence:
    displayName: 확인 가능
  priority:
    displayName: 우선순위
  area:
    displayName: 영역
  updated:
    displayName: 갱신일
views:
  - type: table
    name: Portfolio Evidence
    filters: type == "project"
    order:
      - file.name
      - position
      - formula.status_label
      - focus
      - evidence
      - formula.evidence_gap
      - updated
  - type: table
    name: Skill Stack
    filters: type == "skill-map"
    order:
      - file.name
      - target_role
      - formula.status_label
      - updated
  - type: table
    name: Technical Notes
    filters: type == "ml-note"
    order:
      - file.name
      - area
      - priority
      - formula.status_label
      - updated
  - type: table
    name: Evidence Gaps
    filters:
      and:
        - type == "project"
        - formula.evidence_gap == "보완 필요"
    order:
      - file.name
      - formula.status_label
      - evidence
      - focus
  - type: table
    name: Completed
    filters: status == "completed"
    order:
      - file.name
      - type
      - evidence
      - updated
